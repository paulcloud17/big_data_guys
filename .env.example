# ==============================================================================
# CorpTech Enterprise Lakehouse — Local Environment Configuration
# Copy this file to `.env` before running `docker compose up -d --build`.
# ==============================================================================

# --- Airflow Settings ---
# On Linux/macOS, set AIRFLOW_UID=$(id -u) to match host file ownership.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- Spark Cluster & Runtime ---
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G
SPARK_SHUFFLE_PARTITIONS=8

# --- Lakehouse Storage Paths (inside containers) ---
LANDING_ROOT=/opt/workspace/data/landing
LAKEHOUSE_ROOT=/opt/workspace/lakehouse
SPARK_EVENT_LOG_DIR=/opt/workspace/lakehouse/spark-events

# --- Dataset Download Configuration (Cloudflare R2) ---
# Fill in the credentials provided by your instructor before running scripts/download_data.{sh,ps1,py}.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PREFIX=course-2026/archives
R2_STUDENT_ACCESS_KEY_ID=
R2_STUDENT_SECRET_ACCESS_KEY=

# --- Optional Direct HTTP Archive Override ---
DATASET_DOWNLOAD_URL=

# --- Optional Local MinIO Service (`docker compose --profile minio up -d`) ---
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
